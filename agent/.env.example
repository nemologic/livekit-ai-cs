LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_WS_URL=ws://YOUR_LOCAL_IP:7880

TOKEN_SERVER_PORT=4000
ADMIN_API_URL=http://localhost:4001/api

# 클라우드 LLM을 쓸 때만 (관리자 화면에서 OpenAI 모델을 고른 경우)
OPENAI_API_KEY=

# 토큰 서버 전용 (VPS의 ~/apps/cs-token/.env) — 상담 링크의 주문번호를 esim-api-server에 확인한다.
# ESIM_CS_API_KEY는 esim-api-server의 CS_API_KEY와 같은 값. 비워 두면 형식만 검사한다.
ESIM_API_URL=http://127.0.0.1:3000
ESIM_CS_API_KEY=
# true면 전화번호 인증을 통과한 고객(서명된 입장권)만 상담을 시작할 수 있다.
# 입장권이 없으면 고객 화면이 ORDER_AUTH_URL/<주문번호>로 이동한다.
ESIM_TICKET_REQUIRED=false
ORDER_AUTH_URL=https://my.esimbongsa.com/orders/cs

# 로컬 AI (Ollama + speech/server.py)
LLM_MODEL=qwen2.5:32b
LLM_BASE_URL=http://localhost:11434/v1
SPEECH_BASE_URL=http://localhost:8100/v1

# AnythingLLM 지식 베이스 (챗봇과 공용) — 비워 두면 검색 없이 동작
ANYTHINGLLM_API_KEY=
ANYTHINGLLM_WORKSPACE=esim_cs_center
